# Binance Web3 API credentials. Keep both values server-side (never expose
# OC_SECRET_KEY to the browser). Without them, live market and trade routes
# return 503 — the app never serves mock data.
OC_API_KEY=
OC_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BNB Smart Chain. A public RPC works for reads; use a dedicated RPC for load.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_CHAIN_ID=56

# Optional: WalletConnect project id. When set, the wagmi config adds a
# WalletConnect connector (mobile wallets) alongside injected browser wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Database (Prisma, PostgreSQL). Required for the feed, profiles, portfolio and
# trade history. When unreachable those surfaces are honestly empty, never faked.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fobs?schema=public"
